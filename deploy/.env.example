# Copy to deploy/.env on the host. Never commit the populated file.
DOMAIN=layerflow.example.com
TLS_EMAIL=operator@example.com
# Use a transaction-capable MongoDB replica set/Atlas database. Restrict DB network access to the host.
MONGODB_URI=mongodb+srv://replace-with-your-private-connection
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BUSINESS_TIMEZONE=Asia/Karachi
REMINDER_INTERVAL_MS=60000
MORTALITY_ALERT_PERCENT=2
# Supply only to the explicit one-time bootstrap command, then remove.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
