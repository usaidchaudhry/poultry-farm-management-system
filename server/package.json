{
  "name": "layerflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:dev": "node scripts/dev-database.js",
    "bootstrap": "node --env-file-if-exists=.env src/scripts/bootstrap.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "check:db": "node --env-file-if-exists=.env src/scripts/check-database.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "docs:access": "node scripts/document-access.js",
    "demo:hierarchy": "node --env-file-if-exists=.env src/scripts/demo-hierarchy.js"
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "playwright-core": "^1.65.1",
    "supertest": "^7.3.2"
  }
}
