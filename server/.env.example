NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/layerflow?replicaSet=layerflow
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_MAX_AGE_MS=28800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
BUSINESS_TIMEZONE=Asia/Karachi
UPLOAD_DIR=../.data/uploads
# Supply only for the one-time bootstrap command. Never commit real credentials.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
