NODE_ENV=development
PORT=5000
HOST=127.0.0.1
# Production serves the built SPA by default; development uses Vite.
# SERVE_SPA=true
# SPA_DIR=../dist
MONGODB_URI=mongodb://127.0.0.1:27017/layerflow?replicaSet=layerflow
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_MAX_AGE_MS=28800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
BUSINESS_TIMEZONE=Asia/Karachi
UPLOAD_DIR=../.data/uploads
# Persist UPLOAD_DIR on a private disk; never serve it as a static directory.
REMINDER_INTERVAL_MS=60000
# Demonstration rule only; not a veterinary threshold.
MORTALITY_ALERT_PERCENT=2
# Supply only for the one-time bootstrap command. Never commit real credentials.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Optional local demo only; choose a private 12-128 character temporary password.
DEMO_PASSWORD=
# Enable the seeded account picker only on a loopback, non-production API.
LOCAL_DEMO_LOGIN=false
